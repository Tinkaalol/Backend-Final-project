# ════════════════════════════════════════════════════
# LEANSTOCK BACKEND — ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════

# DATABASE CONFIGURATION
# Local: postgresql://user:password@localhost:5432/dbname
# Docker: postgresql://user:password@postgres:5432/dbname (uses service name)
# Production: use RDS or managed PostgreSQL endpoint
DATABASE_URL=postgresql://leanstock:leanstock@postgres:5432/leanstock

# REDIS CONFIGURATION
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0 (uses service name)
# Production: use managed Redis service
REDIS_URL=redis://redis:6379

# JWT AUTHENTICATION (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ENVIRONMENT & PORTS
NODE_ENV=development
PORT=3000

# CORS CONFIGURATION (comma-separated for multiple origins)
# Local development
CORS_ORIGIN=http://localhost

# EMAIL SERVICE (Real 3rd Party Provider)
# Resend: https://resend.com (Recommended)
# SendGrid: https://sendgrid.com
# Mailgun: https://mailgun.com
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_FROM=LeanStock <onboarding@resend.dev>

# APPLICATION URL (used for email verification links and redirects)
APP_URL=http://localhost:3000

# SUPERADMIN BOOTSTRAP (REQUIRED - one-time setup, generate with: openssl rand -base64 32)
# This key is used only once to create the first superadmin account
SUPERADMIN_SETUP_KEY=superadmin-setup-key-leanstock-2026

# DECAY ENGINE CONFIGURATION
# Controls automatic price reduction for slow-moving inventory
CRON_DECAY_ENABLED=true
DECAY_THRESHOLD_DAYS=30
DECAY_PERCENT_PER_CYCLE=10
DECAY_MAX_DISCOUNT=50

# ════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT (Railway.app / Render.com)
# ════════════════════════════════════════════════════
# For deployment, set these via platform environment variables dashboard
# Use service names (postgres, redis) as hostnames, NOT localhost

# DATABASE_URL=postgresql://user:password@postgres:5432/leanstock
# REDIS_URL=redis://redis:6379
# NODE_ENV=production
# PORT=3000
# CORS_ORIGIN=https://your-app.railway.app
# RESEND_API_KEY=re_YOUR_PRODUCTION_KEY
# EMAIL_FROM=LeanStock <noreply@domain.com>
# APP_URL=https://your-app.railway.app
# SUPERADMIN_SETUP_KEY=REPLACE_WITH_PRODUCTION_SECRET
