# Database Configuration
DATABASE_URL=postgresql://leanstock:leanstock@postgres:5432/leanstock

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Secrets (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Environment
NODE_ENV=development
PORT=3000

# Decay Engine Configuration
CRON_DECAY_ENABLED=true
DECAY_THRESHOLD_DAYS=30
DECAY_PERCENT_PER_CYCLE=10
DECAY_MAX_DISCOUNT=50

# CORS Configuration (for frontend access)
CORS_ORIGIN=http://localhost

# Superadmin Setup Key (REQUIRED - generate with: openssl rand -base64 32)
SUPERADMIN_SETUP_KEY=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# Email Service (Resend)
# Get API key from https://resend.com
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_FROM=LeanStock <onboarding@resend.dev>

# Application URL (used for email links)
APP_URL=http://localhost:3000

# Production DeployRocks example:
# DATABASE_URL=postgresql://user:pass@prod-postgres:5432/leanstock
# REDIS_URL=redis://prod-redis:6379
# NODE_ENV=production
# CORS_ORIGIN=https://your-app.deployrocks.com
# APP_URL=https://your-app.deployrocks.com
