DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/leanstock
REDIS_URL=redis://localhost:6379
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_CHAR_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
PORT=3000
CRON_DECAY_ENABLED=true
DECAY_THRESHOLD_DAYS=30
DECAY_PERCENT_PER_CYCLE=10
DECAY_MAX_DISCOUNT=50
CORS_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_YOUR_API_KEY_HERE
EMAIL_FROM=LeanStock <onboarding@resend.dev>
APP_URL=http://localhost:3000
