{
  "info": {
    "name": "LeanStock Backend API",
    "description": "Complete API collection for LeanStock \u2014 dead-stock decay inventory management system.\n\n**Setup before use:**\n1. baseUrl is already set to http://localhost:3000/api/v1\n2. Set tenantId variable to your tenant UUID (from DB or seed)\n3. Run Register \u2192 Verify Email \u2192 Login in order \u2014 tokens save automatically\n4. All other requests use {{accessToken}} automatically via collection auth",
    "_postman_id": "leanstock-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "a0000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "locationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "\ud83d\udc51 SuperAdmin Setup",
      "item": [
        {
          "name": "1. Setup SuperAdmin (First Time)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@leanstock.com\",\n  \"password\": \"SuperAdmin123\",\n  \"setupKey\": \"dev-setup-key-min-32-char-secret-for-testing\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "setup"
              ]
            },
            "description": "\u26a0\ufe0f RUN FIRST: Bootstrap SuperAdmin account.\nsetupKey from .env SUPERADMIN_SETUP_KEY\nAfter this, verify email and login with superadmin."
          },
          "response": []
        },
        {
          "name": "2. Login as SuperAdmin",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@leanstock.com\",\n  \"password\": \"SuperAdmin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login with superadmin account. Tokens are saved automatically.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                    "  pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);",
                    "  console.log('\u2705 SuperAdmin tokens saved');",
                    "}"
                  ]
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "3. Create Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee Shop KZ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants"
              ]
            },
            "description": "Create a new tenant. SuperAdmin only.\nSave the returned ID as {{tenantId}} for later requests."
          },
          "response": []
        },
        {
          "name": "4. List All Tenants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants"
              ]
            },
            "description": "Get all tenants. SuperAdmin only."
          },
          "response": []
        },
        {
          "name": "5. Create User in Tenant (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@coffeeshop.kz\",\n  \"password\": \"Admin123456\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants/{{tenantId}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants",
                "{{tenantId}}",
                "users"
              ]
            },
            "description": "Create ADMIN user in a tenant. SuperAdmin only.\nUse this email to login on frontend later."
          },
          "response": []
        },
        {
          "name": "6. Create User in Tenant (MANAGER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@coffeeshop.kz\",\n  \"password\": \"Manager123456\",\n  \"role\": \"MANAGER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants/{{tenantId}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants",
                "{{tenantId}}",
                "users"
              ]
            },
            "description": "Create MANAGER user in a tenant. SuperAdmin only."
          },
          "response": []
        },
        {
          "name": "7. Create User in Tenant (STOREKEEPER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"storekeeper@coffeeshop.kz\",\n  \"password\": \"Store123456\",\n  \"role\": \"STOREKEEPER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants/{{tenantId}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants",
                "{{tenantId}}",
                "users"
              ]
            },
            "description": "Create STOREKEEPER user in a tenant. SuperAdmin only."
          },
          "response": []
        },
        {
          "name": "8. List Users in Tenant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants/{{tenantId}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants",
                "{{tenantId}}",
                "users"
              ]
            },
            "description": "Get all users in a tenant. SuperAdmin only."
          },
          "response": []
        },
        {
          "name": "9. Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/superadmin/tenants/{{tenantId}}/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "tenants",
                "{{tenantId}}",
                "users",
                "{{userId}}",
                "role"
              ]
            },
            "description": "Change user role (ADMIN, MANAGER, STOREKEEPER). SuperAdmin only.\nReplace {{userId}} with actual user ID from List Users response."
          },
          "response": []
        },
        {
          "name": "10. List SuperAdmins",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/superadmin/superadmins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "superadmin",
                "superadmins"
              ]
            },
            "description": "List all superadmin accounts. SuperAdmin only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "\ud83c\udfe5 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness probe \u2014 verify server is running. No auth required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "\ud83d\udd10 Auth",
      "item": [
        {
          "name": "1. Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@coffeeshop.kz\",\n  \"password\": \"SecurePass1\",\n  \"role\": \"MANAGER\",\n  \"tenantId\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Register a new user. Sends a real verification email via Resend. User cannot log in until email is verified.\n\nRoles: ADMIN | MANAGER | STOREKEEPER"
          },
          "response": []
        },
        {
          "name": "2. Verify Email",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email?token=PASTE_TOKEN_FROM_EMAIL",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_TOKEN_FROM_EMAIL"
                }
              ]
            },
            "description": "Verify email with the UUID token from the verification email link. After this the user can log in."
          },
          "response": []
        },
        {
          "name": "3. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  console.log('Tokens saved automatically');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@coffeeshop.kz\",\n  \"password\": \"SecurePass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Login and receive JWT tokens. accessToken and refreshToken are automatically saved to collection variables after this request."
          },
          "response": []
        },
        {
          "name": "4. Get Current User (me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns the profile of the currently authenticated user. Demonstrates that Bearer token is working."
          },
          "response": []
        },
        {
          "name": "5. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  console.log('Tokens rotated and saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Issue a new access + refresh token pair. Refresh token is rotated \u2014 the old one is revoked. New tokens saved automatically."
          },
          "response": []
        },
        {
          "name": "6. Forgot Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@coffeeshop.kz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Send password reset link to email. Always returns success to prevent email enumeration."
          },
          "response": []
        },
        {
          "name": "7. Reset Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL\",\n  \"newPassword\": \"NewSecurePass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password"
              ]
            },
            "description": "Reset password with token from email. All existing sessions revoked after reset."
          },
          "response": []
        },
        {
          "name": "8. Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoke refresh token in Redis. Idempotent \u2014 returns 204 even if already expired."
          },
          "response": []
        }
      ]
    },
    {
