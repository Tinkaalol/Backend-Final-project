{
  "name": "leanstock-backend",
  "version": "1.0.0",
  "description": "Inventory management system for coffee equipment and beans",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "npm run migrate && node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --forceExit",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --runInBand --forceExit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node src/seed.js",
    "db:reset": "node src/reset.js && node src/seed.js",
    "lint": "eslint src/ tests/",
    "postinstall": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "prisma": "^6.19.3",
    "rate-limiter-flexible": "^5.0.0",
    "resend": "^3.2.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {}
  }
}
